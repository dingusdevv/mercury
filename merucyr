layout.Parent = scrolling

local function setStatus(message)
    status.Text = message
end

local function makeButton(name, callback)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Text = name
    button.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(20, 20, 20)
    button.TextSize = 14
    button.Font = Enum.Font.SourceSans
    button.Parent = scrolling

    button.MouseButton1Click:Connect(function()
        local success, err = pcall(callback)

        if success then
            setStatus(name .. ": done")
        else
            setStatus(name .. ": " .. tostring(err))
            warn("[Mercury] " .. tostring(err))
        end
    end)

    return button
end

local function isPlayerCharacter(object)
    for _, target in ipairs(Players:GetPlayers()) do
        if target.Character == object then
            return true
        end
    end
    return false
end

-- DELETE TOOL
makeButton("Delete Tool", function()
    if not DeleteCar then
        error("DeleteCar remote not found")
    end

    local mouse = player:GetMouse()

    local tool = Instance.new("Tool")
    tool.Name = "Delete Tool"
    tool.RequiresHandle = false
    tool.CanBeDropped = false

    tool.Activated:Connect(function()
        local target = mouse.Target

        if not target then
            return
        end

        local model = target:FindFirstAncestorOfClass("Model")

        if model and isPlayerCharacter(model) then
            setStatus("Cannot target player characters")
            return
        end

        DeleteCar:FireServer(target)
    end)

    tool.Parent = player:WaitForChild("Backpack")
end)

-- DESTROY WORKSPACE (WEAK)
-- Uses DeleteCar on direct Workspace children only.
makeButton("Destroy Workspace", function()
    if not DeleteCar then
        error("DeleteCar remote not found")
    end

    local count = 0

    for _, object in ipairs(workspace:GetChildren()) do
        if object ~= workspace.Terrain
            and object ~= workspace.CurrentCamera
            and not object:IsA("SpawnLocation")
            and not isPlayerCharacter(object) then

            DeleteCar:FireServer(object)
            count += 1
            task.wait(0.1)
        end
    end

    setStatus("Workspace requests sent: " .. count)
end)

-- LOCAL WORKSPACE CLEANUP
-- Only changes what this client sees.
makeButton("Local Workspace Clean", function()
    local count = 0

    for _, object in ipairs(workspace:GetChildren()) do
        if object ~= workspace.Terrain
            and object ~= workspace.CurrentCamera
            and not object:IsA("SpawnLocation")
            and not isPlayerCharacter(object) then

            object:Destroy()
            count += 1
        end
    end

    setStatus("Local objects removed: " .. count)
end)

-- DESTROY LIGHTING
makeButton("Destroy Lighting", function()
    for _, object in ipairs(Lighting:GetDescendants()) do
        object:Destroy()
    end

    setStatus("Lighting cleared locally")
end)

-- DESTROY GUI
makeButton("Destroy GUI", function()
    for _, object in ipairs(playerGui:GetChildren()) do
        if object ~= gui then
            object:Destroy()
        end
    end

    setStatus("Your PlayerGui cleared")
end)

-- DESTROY TOOLS
makeButton("Destroy Tools", function()
    local backpack = player:FindFirstChildOfClass("Backpack")
    local character = player.Character
    local count = 0

    if backpack then
        for _, object in ipairs(backpack:GetChildren()) do
            if object:IsA("Tool") and object.Name ~= "Delete Tool" then
                object:Destroy()
                count += 1
            end
        end
    end

    if character then
        for _, object in ipairs(character:GetChildren()) do
            if object:IsA("Tool") and object.Name ~= "Delete Tool" then
                object:Destroy()
                count += 1
            end
        end
    end

    setStatus("Your tools removed: " .. count)
end)

-- SPAWN VEHICLES
local function spawnVehicle(vehicleName)
    if not SpawnCar then
        error("SpawnCar remote not found")
    end

    SpawnCar:FireServer(vehicleName)
end

makeButton("Spawn Ship", function()
    spawnVehicle("Our Rocket Ship")
end)

makeButton("Spawn Space Buggy", function()
    spawnVehicle("Space Buggy")
end)

-- SHIP LOOP
local shipButton

shipButton = makeButton("Ship Loop: OFF", function()
    shipRunning = not shipRunning

    if shipRunning then
        shipButton.Text = "Ship Loop: ON"

        task.spawn(function()
            local count = 0

            while shipRunning and count < MAX_LOOP_SPAWNS do
                spawnVehicle("Our Rocket Ship")
                count += 1
                task.wait(LOOP_DELAY)
            end

            shipRunning = false
            shipButton.Text = "Ship Loop: OFF"
            setStatus("Ship loop stopped")
        end)
    else
        shipButton.Text = "Ship Loop: OFF"
    end
end)

-- BUGGY LOOP
local buggyButton

buggyButton = makeButton("Buggy Loop: OFF", function()
    buggyRunning = not buggyRunning

    if buggyRunning then
        buggyButton.Text = "Buggy Loop: ON"

        task.spawn(function()
            local count = 0

            while buggyRunning and count < MAX_LOOP_SPAWNS do
                spawnVehicle("Space Buggy")
                count += 1
                task.wait(LOOP_DELAY)
            end

            buggyRunning = false
            buggyButton.Text = "Buggy Loop: OFF"
            setStatus("Buggy loop stopped")
        end)
    else
        buggyButton.Text = "Buggy Loop: OFF"
    end
end)

-- STOP BOTH LOOPS
makeButton("Stop All Loops", function()
    shipRunning = false
    buggyRunning = false

    shipButton.Text = "Ship Loop: OFF"
    buggyButton.Text = "Buggy Loop: OFF"

    setStatus("All loops stopped")
end)

